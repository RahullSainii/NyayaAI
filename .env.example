GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=your_gemini_api_key
LLM_FALLBACKS=gemini:gemini-flash-lite-latest,gemini:gemini-flash-latest,gemini:gemini-3.5-flash,gemini:gemini-2.0-flash,gemini:gemini-2.5-flash

QDRANT_URL=your_qdrant_url
QDRANT_API_KEY=

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# REQUIRED. The app refuses to start without this. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_long_random_secret

# Required to use the destructive /ingest endpoint. If left blank, /ingest is
# disabled. Send it as the "X-Admin-Key" header when calling /ingest.
ADMIN_API_KEY=

EMAIL_FROM=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_email_app_password
SMTP_SECURE=false

ENABLE_VECTOR_MODELS=false
ENABLE_PDF_INGESTION=true

# Web search fallback (used only when the knowledge base has no answer).
# Set a provider key for best quality; otherwise a keyless DuckDuckGo fallback is used.
ENABLE_WEB_SEARCH=true
TAVILY_API_KEY=
SERPER_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# Relevance gating thresholds (optional overrides)
RERANK_SCORE_FLOOR=0.3
MIN_TERM_COVERAGE=0.2

FRONTEND_ORIGIN=https://your-frontend.onrender.com
FRONTEND_ORIGINS=
# Set to false in production so only the configured frontend origin(s) are allowed.
CORS_ALLOW_LOCALHOST=true

# Postgres connection pool bounds (hosted DBs like Neon cap concurrent connections).
DB_POOL_MIN=1
DB_POOL_MAX=10

# Chat input limits (bound LLM cost / payload size).
MAX_QUERY_CHARS=4000
MAX_HISTORY_MESSAGES=12

