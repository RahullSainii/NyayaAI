# ==========================================
# Python
# ==========================================
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
.venv/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ==========================================
# Node / Frontend
# ==========================================
node_modules/
dist/
.vite/
*.tsbuildinfo

# ==========================================
# Environment & Secrets
# ==========================================
.env
.env.local
.env.*.local
.env.production
.env.staging

# Do NOT ignore .env.example — it's the safe template
!.env.example
!frontend/.env.example

# ==========================================
# Sensitive / Generated Data
# ==========================================
# User store and local DB (contain user data / password hashes)
backend/users.json
*.db
data/*.db

# NOTE: data/.chunk_cache.json is intentionally committed so hosts with tight
# memory (e.g. Render free tier) load chunks from cache instead of re-parsing
# every PDF with pdfplumber at startup (which can OOM).

# ==========================================
# IDE & Editors
# ==========================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# OS Files
# ==========================================
.DS_Store
ehthumbs.db
*.lnk

# ==========================================
# Build & Deploy
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
