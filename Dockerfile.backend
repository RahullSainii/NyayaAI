# ── Build stage: install Python dependencies ────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

COPY backend/requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ── Runtime stage: lean production image ─────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

# System deps needed at runtime (psycopg2-binary, etc.)
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Copy only installed packages from the builder stage.
COPY --from=builder /install /usr/local

# Copy application code (data/ is mounted as a volume, NOT baked in).
COPY backend/ ./backend/

# Security: run as a non-root user.
RUN groupadd -r appuser && useradd -r -g appuser appuser \
    && chown -R appuser:appuser /app
USER appuser

ENV PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Bind to the port Render provides via $PORT (falls back to 8000 locally).
# sh -c is required so ${PORT} is expanded at runtime, then exec hands signals to Uvicorn.
CMD ["sh", "-c", "exec uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
