# ── Build stage: compile the React app ───────────────────────────────────
FROM node:20-slim AS build

WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .

# NOTE: Do NOT declare ARG with the same name as VITE_ env vars here.
# Render sets env vars as regular environment variables during build, NOT as
# Docker --build-arg. Declaring ARG VITE_GOOGLE_CLIENT_ID would shadow the
# real env var with an empty value (since no --build-arg is passed), and the
# RUN command below would write an empty string into the Vite bundle.
RUN VITE_GOOGLE_CLIENT_ID="${VITE_GOOGLE_CLIENT_ID:-${VITE_GOOGLE_OAUTH_CLIENT_ID:-${GOOGLE_CLIENT_ID:-}}}" \
    VITE_API_BASE_URL="${VITE_API_BASE_URL:-}" \
    VITE_SENTRY_DSN="${VITE_SENTRY_DSN:-}" \
    npm run build

# ── Production stage: serve static files with nginx ──────────────────────
FROM nginx:stable-alpine

# Copy built assets only (no source code, no node_modules).
COPY --from=build /app/dist /usr/share/nginx/html

# Copy production nginx configuration.
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY scripts/write-frontend-runtime-config.sh /docker-entrypoint.d/30-write-frontend-runtime-config.sh
RUN chmod +x /docker-entrypoint.d/30-write-frontend-runtime-config.sh

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]

