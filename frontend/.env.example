# Vite reads env files from THIS folder (frontend/), not the repo root.
# Only variables prefixed with VITE_ are exposed to the browser, and they are
# baked in at BUILD time - you must rebuild after changing them.

# Google OAuth client ID (public value). Must match a Web client whose
# "Authorized JavaScript origins" include your frontend URL(s).
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Backend base URL. Leave blank for local dev (vite proxy handles it).
# In production set to your deployed backend, e.g. https://your-backend.onrender.com
VITE_API_BASE_URL=
